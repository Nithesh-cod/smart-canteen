# ============================================================================
# SMART CANTEEN — BACKEND ENVIRONMENT
# ============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is
# committed and must never contain a real secret.
#
# Generate the JWT secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Firestore / Firebase Admin ────────────────────────────────────────────────
# The datastore. Credentials are resolved in this order, first match wins
# (see src/config/firebase.js):
#   1. FIRESTORE_EMULATOR_HOST     — local dev / tests, no real credentials
#   2. FIREBASE_SERVICE_ACCOUNT    — the whole service-account JSON, inline
#   3. GOOGLE_APPLICATION_CREDENTIALS — path to a service-account .json file
#   4. ambient credentials         — Cloud Run / Cloud Functions
FIREBASE_PROJECT_ID=your-firebase-project-id

# Preferred on Render/Vercel/any hosted env: paste the ENTIRE service-account
# JSON on one line. Keep it quoted.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

# Local dev alternative: path to the key file, relative to backend/.
# NEVER commit the file it points at.
# GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# Set ONLY for local dev against the emulator (`npm test` sets it for you).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex
JWT_EXPIRES_IN=24h

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED IN PRODUCTION. Razorpay Dashboard → Settings → Webhooks → the
# secret you set on the payment.captured subscription.
# src/app.js refuses to boot when NODE_ENV=production and this is unset:
# without it every webhook returns 500 and Razorpay retries in a storm.
RAZORPAY_WEBHOOK_SECRET=replace_with_the_webhook_secret

# ── Receipt printer ───────────────────────────────────────────────────────────
# PRINTER_TYPE: windows | network | bluetooth | none
#   windows   — prints via the Windows spooler; needs PRINTER_NAME
#   network   — ESC/POS over TCP; needs PRINTER_ADDRESS (+ PRINTER_PORT)
#   bluetooth — ESC/POS over a paired serial port; needs PRINTER_ADDRESS
#   none      — no printer; the API returns a base64 PDF receipt instead
PRINTER_TYPE=none
PRINTER_NAME=
PRINTER_ADDRESS=
PRINTER_PORT=9100

# ── Receipt header details ────────────────────────────────────────────────────
CANTEEN_NAME=Smart Canteen
CANTEEN_COLLEGE=Your College Name
CANTEEN_ADDRESS=Campus Address
CANTEEN_GSTIN=
CANTEEN_PHONE=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated extra origins allowed to call the API. http://localhost:3000
# is always allowed. Set this to your deployed frontend URL — when the frontend
# is hosted separately (Vercel) and this is blank, every browser request from
# it is rejected by CORS.
FRONTEND_URLS=https://your-app.vercel.app

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ============================================================================
# REMOVED — do not reintroduce
# ============================================================================
# DATABASE_URL / DB_HOST / DB_USER / DB_PASSWORD / DB_NAME / DB_PORT
#   The app moved from Postgres/Supabase to Firestore. Only the legacy
#   scripts/migrate.js still reads these; the server does not.
#
# SUPABASE_URL / SUPABASE_ANON_KEY
#   Realtime is Firestore listeners now, not Supabase channels.
#
# ADMIN_ROLLS / CHEF_ROLLS
#   Roles came from these env lists once, which meant anyone who knew a roll
#   number got staff access. Role is now the students.role field in Firestore
#   and is the single source of truth (see src/middleware/auth.middleware.js).
#   Create staff accounts with:
#     npm run create-admin -- --name "Owner" --roll OWNER001 \
#       --phone 9999999999 --password "strong-password" --role admin
