# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# Keep .env.example (it's safe — no real secrets)

# Firebase service-account private keys — NEVER commit these
serviceAccountKey.json
**/serviceAccountKey.json
*firebase-adminsdk*.json

# Firebase emulator artifacts
*-debug.log
.firebase/

# ── Build output ──────────────────────────────────────────────────────────────
dist/
dist-chef/
dist-owner/
build/

# ── Local archives ────────────────────────────────────────────────────────────
# Snapshot zips of the project (these bundle node_modules and run to hundreds
# of MB — they must never reach a commit).
*.zip

# ── Vite ─────────────────────────────────────────────────────────────────────
frontend/.vite/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── TypeScript cache ──────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Local editor / tooling state ──────────────────────────────────────────────
.claude/
.vscode/
.idea/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.local
coverage/
.nyc_output/

# Local archive — 205MB, not source
smart-canteen.zip

# Generated production env dumps — contain real secrets
render.env.txt
*.env.txt

# ── Capacitor native project ─────────────────────────────────────────────────
# android/ IS committed on purpose. It is not purely generated: the launcher
# background colour, app name, permissions and (later) signing config live in
# there, and `npx cap add android` would silently revert them. Only the build
# outputs are ignored.
frontend/android/build/
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/release/
frontend/android/capacitor-cordova-android-plugins/
frontend/ios/App/Pods/
frontend/ios/App/build/

# Web assets copied into the native project by `npx cap sync` — a duplicate of
# frontend/dist, which is itself ignored.
frontend/android/app/src/main/assets/public/

# Built APKs. Kept out of git deliberately: a 13MB binary that changes on every
# build would live in history forever and could not be removed without a rewrite.
# Ship builds via GitHub Releases (gh release upload) instead.
*.apk
*.aab
