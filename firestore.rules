rules_version = '2';

// ============================================================================
// Smart Canteen — Firestore Security Rules
// ============================================================================
// Model:
//   • ALL writes go through the Express API (Admin SDK), which BYPASSES these
//     rules. So every collection is `allow write: if false` for clients.
//   • Clients only READ. Public data (menu, offers) is world-readable. Sensitive
//     data (orders, students) requires a signed-in Firebase user whose custom
//     token carries the right role claim (minted by /api/auth/firebase-token).
//   • Guests never read orders via Firestore — order tracking uses the REST API.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role()     { return request.auth.token.role; }
    function isStaff()  { return signedIn() && (role() == 'chef' || role() == 'admin'); }
    function isAdmin()  { return signedIn() && role() == 'admin'; }

    // ── Public menu & offers — world-readable, server-writable only ──────────
    match /menu_items/{id} {
      allow read:  if true;
      allow write: if false;
    }
    match /offers/{id} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Orders — chef & admin dashboards only (contain customer PII) ─────────
    match /orders/{id} {
      allow read:  if isStaff();
      allow write: if false;
    }

    // ── Students — admin (owner roster) or the student reading their own doc ──
    match /students/{id} {
      allow read:  if isAdmin() || (signedIn() && request.auth.uid == id);
      allow write: if false;

      match /favorites/{favId} {
        allow read:  if signedIn() && request.auth.uid == id;
        allow write: if false;
      }
    }

    // ── Internal counters — server only, never exposed to clients ────────────
    match /counters/{id} {
      allow read, write: if false;
    }

    // ── Anything else — deny by default ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
