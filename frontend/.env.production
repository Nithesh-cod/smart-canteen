# Production build values — committed to git, no secrets here.
# The Firebase web config is public by design (protected by Security Rules).
# RAZORPAY_KEY_ID is the public half only — the secret stays on the backend.

# API goes through the Vercel rewrite → Render (vercel.json handles the proxy)
VITE_API_URL=/api
# Sockets connect DIRECTLY to Render, not through the Vercel rewrite — Vercel's
# rewrites proxy HTTP but do not carry a websocket upgrade, so this must be the
# absolute backend origin while VITE_API_URL stays relative.
VITE_SOCKET_URL=https://smart-canteen-api-k9oi.onrender.com

# ─── Firebase (Firestore) — public web config ────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSyAPbpkc1NGamzesv1HxtG60mnXYVDRixF8
VITE_FIREBASE_AUTH_DOMAIN=smart-canteen-64c7e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-canteen-64c7e
VITE_FIREBASE_STORAGE_BUCKET=smart-canteen-64c7e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=564173248353
VITE_FIREBASE_APP_ID=1:564173248353:web:b4893e815b23f6b2979720

# Razorpay — public key ID only
VITE_RAZORPAY_KEY_ID=rzp_test_SevioqqSvxYZp8
